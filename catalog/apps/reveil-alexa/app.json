{
	"id": "reveil-alexa",
	"name": "Réveil Alexa",
	"packageName": "fr.portal.reveilalexa",
	"description": "Hands-free \"Alexa\" on Portals running Android 10: an offline wake-word listener (Vosk, French model) that opens the Alexa app when you say \"Alexa\", and takes the mic back automatically when Android silences it",
	"category": "assistant",
	"version": "latest",
	"source": "github",
	"repo": "zaka0002/reveil-alexa",
	"downloadUrl": "https://github.com/zaka0002/reveil-alexa/releases/latest",
	"iconFile": "svg",
	"requires": ["com.amazon.dee.app"],
	"program": {
		"kind": "commands",
		"auto": true,
		"commands": [
			"pm grant fr.portal.reveilalexa android.permission.RECORD_AUDIO",
			"appops set fr.portal.reveilalexa SYSTEM_ALERT_WINDOW allow",
			"dumpsys deviceidle whitelist +fr.portal.reveilalexa",
			"am start -n fr.portal.reveilalexa/.MainActivity"
		],
		"labelKey": "grantPermissions"
	}
}
