{
	"id": "amazon-alexa",
	"name": "Alexa (Portal)",
	"packageName": "com.amazon.alexa.multimodal.falcon",
	"description": "The Alexa client Meta originally shipped on the Portal (falcon), revived by Starbright Lab. After install it opens its sign-in screen: enter the code shown at amazon.com/code. Réveil Alexa uses it for hands-free \"Alexa\". Uninstall the regular Amazon Alexa phone app first: it blocks this install",
	"category": "assistant",
	"version": "1.0.5542.0",
	"source": "url",
	"apkUrl": "https://github.com/starbrightlab/hey-dist/releases/download/v0.1.0/falcon.apk",
	"apkSha256": "76133f807e492e46aaf58e6ae503e623a93af840eaa3eccfb8630f1ecab3268d",
	"repo": "starbrightlab/hey-dist",
	"skipUpdateCheck": true,
	"program": {
		"kind": "commands",
		"auto": true,
		"commands": [
			"pm grant com.amazon.alexa.multimodal.falcon android.permission.RECORD_AUDIO",
			"pm grant com.amazon.alexa.multimodal.falcon android.permission.READ_PHONE_STATE",
			"pm grant com.amazon.alexa.multimodal.falcon android.permission.INTERACT_ACROSS_USERS",
			"appops set com.amazon.alexa.multimodal.falcon SYSTEM_ALERT_WINDOW allow",
			"settings put secure user_setup_complete 1",
			"am force-stop com.amazon.alexa.multimodal.falcon",
			"am start -n com.amazon.alexa.multimodal.falcon/com.amazon.alexa.multimodal.LaunchActivity"
		],
		"labelKey": "grantPermissions"
	}
}
